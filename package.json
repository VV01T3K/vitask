{
  "name": "vitask",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter @vitask/worker --filter @vitask/web dev",
    "build": "vpr -r build",
    "check": "vpr -r check",
    "fix": "vpr -r fix",
    "test": "vpr -r test",
    "eval": "vpr --filter @vitask/evals eval",
    "eval:faux": "vpr --filter @vitask/evals eval:faux",
    "eval:matrix": "vpr --filter @vitask/evals eval:matrix"
  },
  "devDependencies": {
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.33.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss",
      "workerd"
    ]
  }
}
