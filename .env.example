# For `docker compose up` (compose.yaml). Copy to .env and fill in; .env is git-ignored.

# The public hostname, and the https origin users open. Passkeys are bound to the hostname: choose it before anyone
# signs up. Locally: VITASK_DOMAIN=localhost, HTTPS_PORT=8443, BETTER_AUTH_URL=https://localhost:8443.
VITASK_DOMAIN=vitask.example.com
BETTER_AUTH_URL=https://vitask.example.com
HTTP_PORT=80
HTTPS_PORT=443

GROQ_API_KEY=
# Random, 32+ characters each: openssl rand -base64 32
COOKIE_SECRET=
BETTER_AUTH_SECRET=

# Credentials of the local bucket (RustFS). Pick any; the secret needs 8+ characters.
S3_ACCESS_KEY=vitask
S3_SECRET_KEY=
