{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // celld requires: wrangler.jsonc, this exact script name (idFromName keys derive from it), only new_sqlite_classes.
  "name": "vitask",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [{ "name": "WORKSPACE", "class_name": "WorkspaceObject" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["WorkspaceObject"] }],
  // Accounts, sessions and passkeys (Better Auth). Schema in migrations/, applied with `vpr db:migrate` (see AGENTS.md).
  // On Cloudflare, replace database_id with the id `wrangler d1 create vitask-auth` prints; celld uses it as the name.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vitask-auth",
      "database_id": "vitask-auth",
      "migrations_dir": "migrations",
    },
  ],
  // migrations/*.sql as text modules, for src/dev-migrations.ts.
  "rules": [{ "type": "Text", "globs": ["**/*.sql"] }],
  "assets": {
    // apps/web builds into this git-ignored directory (`vpr -r build`): celld accepts only an asset directory inside
    // the project. Unknown paths fall back to its index.html.
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "vars": {
    "COACH_PROVIDER": "groq",
    "COACH_MODEL": "openai/gpt-oss-120b",
    "DAILY_TOKEN_BUDGET": "200000",
    "CHAT_RATE_LIMIT_PER_MINUTE": "10",
    "MAX_SESSION_MINUTES": "240",
    "MIN_TIMER_INTERVAL_SECONDS": "60",
    "APPROVAL_TTL_SECONDS": "600",
    "ALLOWED_ORIGINS": "",
    // The app's public origin: passkeys are bound to its hostname. In development the
    // web dev server (`vpr dev`) proxies /api here, so the browser's origin is the dev server's.
    "BETTER_AUTH_URL": "http://localhost:5173",
    // Development only. scripts/deploy-celld.mjs refuses to deploy without real secrets in the environment.
    "COOKIE_SECRET": "dev-only-insecure-cookie-secret",
    "BETTER_AUTH_SECRET": "dev-only-insecure-better-auth-secret-0123456789",
  },
}
